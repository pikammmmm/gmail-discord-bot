# Copy this file to .env and fill in the real values.
# .env is gitignored so your secrets stay out of version control.

# ---- Discord bot (required) ----
# Get one: https://discord.com/developers/applications -> New Application
# -> Bot -> Reset Token -> Copy
DISCORD_BOT_TOKEN=your-bot-token-here

# ---- Destination: set ONE of these (DM_USER_ID takes precedence) ----

# Option A: DM mode - the bot sends emails to you as Direct Messages.
# Right-click your OWN profile in Discord -> Copy User ID.
# (Enable Developer Mode first: Settings -> Advanced -> Developer Mode.)
# You must share at least one server with the bot and have DMs enabled
# for that server.
DM_USER_ID=

# Option B: Channel mode - post in a server channel instead.
# Right-click the target channel -> Copy Channel ID.
DISCORD_CHANNEL_ID=

# ---- Gmail polling ----
# How often to check Gmail for new messages, in seconds. Minimum 10.
POLL_INTERVAL_SECONDS=60
