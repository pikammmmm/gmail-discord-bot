# Copy this file to .env and fill in the real values.
# .env is gitignored so your secrets stay out of version control.

# The Discord webhook URL that receives forwarded emails.
# Get one: Discord -> Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXXXX/YYYYYYYYYY

# How often to check Gmail, in seconds. Minimum 10.
POLL_INTERVAL_SECONDS=60
